{
  "name": "@shihangw/rowrunner",
  "version": "0.1.0",
  "description": "Turn cumulative progress into smooth live speed estimates, procedural 3D scenes, and animated mascots.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/progress_sink.d.ts",
      "import": "./dist/progress_sink.js"
    },
    "./scene": {
      "types": "./dist/road_scene.d.ts",
      "import": "./dist/road_scene.js"
    },
    "./server": {
      "types": "./dist/progress_http_server.d.ts",
      "import": "./dist/progress_http_server.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./geometry": {
      "types": "./dist/road_geometry.d.ts",
      "import": "./dist/road_geometry.js"
    },
    "./schemas": {
      "types": "./dist/public_schemas.d.ts",
      "import": "./dist/public_schemas.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "npm run dev --workspace examples",
    "demo": "npm start",
    "test": "npm run build && npm run test:types && node --import tsx --test",
    "prepack": "npm run lint && npm test",
    "typecheck": "npm run typecheck --workspace examples && npm run test:types",
    "build:example": "npm run build --workspace examples",
    "build": "tsc -p tsconfig.json",
    "test:types": "tsc --noEmit -p type-tests/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "prelint:fix": "npm run build",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "check:package": "npm run build && node scripts/check_package.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "progress",
    "throughput",
    "speedometer",
    "animation",
    "webgl"
  ],
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.0",
    "zod": "4.6.5"
  },
  "workspaces": [
    "examples"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^26.6.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "gts": "7.0.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shihangw/rowrunner"
  },
  "homepage": "https://github.com/shihangw/rowrunner#readme",
  "bugs": {
    "url": "https://github.com/shihangw/rowrunner/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
